# Copiar a .env y ajustar. El archivo .env no se versiona.

# --- BD de historial (PostgreSQL externo con pgmq instalado por app/migrar.py) ---
HIST_DSN=postgresql://postgres:2009@192.168.10.146:5432/sire

# --- BD de Bizlinks (producción, solo lectura) ---
# La app abre todas sus transacciones en Bizlinks como solo lectura.
# Antes: BD de producción en 192.168.0.24 (192.168.0.24:5432/BIZLINKS_PROD21)
# Ahora: backup restaurado en el PostgreSQL local
BIZLINKS_DSN=postgresql://postgres:2009@192.168.10.146:5432/BIZLINKS_PROD21
# Solo para la BD simulada (docker compose --profile simulado): clave del contenedor bizlinks_dev
BIZLINKS_DEV_PASSWORD=2009

# --- Comparación ---
TOLERANCIA=0.01

# --- Worker ---
# Segundos que un mensaje queda invisible mientras se procesa (se extiende solo).
WORKER_VT=120
MAX_INTENTOS=3

# --- Web ---
MAX_ARCHIVO_MB=50
LOG_LEVEL=INFO
